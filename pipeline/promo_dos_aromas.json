 "scenes": [
  {
   "id": "s9",
   "text": "¿Lavanda y manzanilla, o citronela y árbol de té? ¿Cuál eliges tú?"
  },
  {
   "id": "s5",
   "text": "Los dos son EcoVital: desodorante natural, sin aluminio, en frasco de vidrio."
  },
  {
   "id": "s25",
   "text": "Lavanda y manzanilla es suave y floral. Citronela y árbol de té, fresco y herbal."
  },
  {
   "id": "s4",
   "text": "Sus plantas ayudan a neutralizar el olor sin tapar tus poros."
  },
  {
   "id": "s6",
   "text": "Comenta tu aroma y pídelo hoy: envíos a toda Colombia y pagas al recibir."
  }
