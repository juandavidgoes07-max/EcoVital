 "scenes": [
  {
   "id": "s10",
   "text": "¿Sabías que la manzanilla se llama así porque huele a manzana?"
  },
  {
   "id": "s11",
   "text": "En español, manzanilla significa literalmente manzana pequeña."
  },
  {
   "id": "s12",
   "text": "Y su nombre en griego, camomila, quiere decir manzana de la tierra."
  },
  {
   "id": "s13",
   "text": "Si frotas sus flores, sueltan un aroma dulce muy parecido al de la fruta."
  },
  {
   "id": "s14",
   "text": "Por eso se usa desde hace siglos en infusiones, jabones y aceites."
  },
  {
   "id": "s15",
   "text": "La próxima vez que tomes una aromática, ya sabes de dónde viene su nombre."
  }
 ],
