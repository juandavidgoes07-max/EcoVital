 "scenes": [
  {
   "id": "s26",
   "text": "¿Tu desodorante natural no te funciona? Quizá cometes uno de estos tres errores."
  },
  {
   "id": "s27",
   "text": "Error uno: aplicarlo con la axila mojada. Sécate bien después del baño."
  },
  {
   "id": "s28",
   "text": "Error dos: ponerlo encima del olor de ayer. Aplícalo siempre sobre piel limpia."
  },
  {
   "id": "s8",
   "text": "Error tres, el más común: rendirte en la primera semana."
  },
  {
   "id": "s3",
   "text": "Es normal sentir más humedad: ya no hay aluminio tapando tus poros."
  },
  {
   "id": "s5",
   "text": "Prueba EcoVital, sin aluminio, en lavanda y manzanilla o citronela y árbol de té."
  },
  {
   "id": "s6",
   "text": "¿Cuál error cometías tú? Pide el tuyo: envíos a toda Colombia y pagas al recibir."
  }
 ],
