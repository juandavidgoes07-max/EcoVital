 "scenes": [
  {
   "id": "s35",
   "text": "¿Te tocó amigo secreto y no sabes qué regalar? Tengo la idea perfecta."
  },
  {
   "id": "s5",
   "text": "Un desodorante natural EcoVital: sin aluminio, en frasco de vidrio con tapa dorada."
  },
  {
   "id": "s25",
   "text": "¿Le gusta lo suave? Lavanda y manzanilla. ¿Lo fresco? Citronela y árbol de té."
  },
  {
   "id": "s36",
   "text": "Es un regalo útil, que se usa todos los días, no un adorno más."
  },
  {
   "id": "s4",
   "text": "Y sus plantas ayudan a neutralizar el olor sin tapar los poros."
  },
  {
   "id": "s6",
   "text": "Pídelo hoy para tu amigo secreto: envíos a toda Colombia y pagas al recibir."
  }
