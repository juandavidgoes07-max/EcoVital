 "scenes": [
  {
   "id": "s21",
   "text": "¿Sabías que la citronela es familia del maíz, el arroz y la caña de azúcar?"
  },
  {
   "id": "s22",
   "text": "Todas son gramíneas, la misma familia del pasto de tu jardín."
  },
  {
   "id": "s23",
   "text": "Y su prima más cercana es el limoncillo: las dos son del género Cymbopogon."
  },
  {
   "id": "s24",
   "text": "Su nombre viene del francés citron, que significa limón, por su aroma cítrico."
  },
  {
   "id": "s21",
   "text": "Ahora ya sabes: la citronela huele a limón, pero en realidad es un pasto."
  }
 ],
