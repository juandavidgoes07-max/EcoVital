 "scenes": [
  {
   "id": "s16",
   "text": "¿Sabías que el árbol de té no tiene nada que ver con el té que tomas?"
  },
  {
   "id": "s17",
   "text": "El té que tomas sale de otra planta, la Camellia sinensis, originaria de Asia."
  },
  {
   "id": "s18",
   "text": "El árbol de té es un arbusto australiano llamado Melaleuca."
  },
  {
   "id": "s19",
   "text": "Se cuenta que los marineros del capitán Cook prepararon té con hojas parecidas."
  },
  {
   "id": "s20",
   "text": "Pero ojo: su aceite es de uso externo, nunca se debe tomar."
  },
  {
   "id": "s16",
   "text": "Ahora ya sabes: el árbol de té tiene nombre de té, pero no es té."
  }
