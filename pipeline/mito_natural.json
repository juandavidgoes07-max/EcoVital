 "scenes": [
  {
   "id": "s7",
   "text": "¿El desodorante natural no funciona? Eso es un mito."
  },
  {
   "id": "s3",
   "text": "Los antitranspirantes tapan tus poros con aluminio para que no sudes."
  },
  {
   "id": "s4",
   "text": "Uno natural no tapa nada: deja respirar tu piel y neutraliza el olor con plantas."
  },
  {
   "id": "s8",
   "text": "Al cambiar, los primeros días puedes notar más humedad. Es normal: tu piel se está adaptando."
  },
  {
   "id": "s5",
   "text": "Prueba EcoVital, con lavanda y manzanilla, o citronela y árbol de té. Sin aluminio."
  },
  {
   "id": "s6",
   "text": "Síguenos para más tips naturales y pide el tuyo: pagas cuando te llega."
  }
