 "scenes": [
  {
   "id": "s29",
   "text": "Tres alimentos que llevas toda la vida clasificando mal. El último casi nadie lo sabe."
  },
  {
   "id": "s30",
   "text": "Número tres: el plátano. Para la botánica, sí es una baya."
  },
  {
   "id": "s31",
   "text": "Número dos: la fresa. Aunque parezca una baya, no lo es."
  },
  {
   "id": "s32",
   "text": "Esos puntitos de afuera son sus verdaderos frutos, y cada uno guarda una semilla."
  },
  {
   "id": "s33",
   "text": "Y el número uno: el maní. No es una nuez, es una legumbre, como el fríjol y la lenteja."
  },
  {
   "id": "s34",
   "text": "Y algo más: sus vainas maduran bajo tierra, no en un árbol."
  },
  {
   "id": "s29",
   "text": "Ahora ya sabes. ¿Cuál de los tres te sorprendió más?"
  }
 ],
