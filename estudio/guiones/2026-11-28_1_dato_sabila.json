   }
  },
  {
   "id": "s3",
   "plantilla": "versus",
   "text": "Casi todos los cactus son de América. La sábila es de otra familia de plantas, muy distinta.",
   "p": {
    "a": "sabila",
    "b": "cactus",
    "etA": "Sábila · Arabia",
    "etB": "Cactus · América",
    "giroHeroe": 0.25,
    "yA": 1.15,
    "yB": 1.3,
    "colorB": "#ff8a3d"
   }
  },
  {
   "id": "s4",
   "plantilla": "sello",
   "text": "En el cactus, las espinas son hojas transformadas, y lo verde que ves es el tallo.",
   "p": {
    "heroe": "cactus",
    "giroHeroe": 0.3,
    "texto": "ESPINAS = HOJAS",
    "tipo": "realidad",
    "frase": "Lo verde del cactus es el <b>tallo</b>"
   }
  },
  {
   "id": "s5",
   "plantilla": "dato",
   "text": "En la sábila, lo verde sí son hojas: gruesas, y por dentro guardan un gel transparente.",
   "p": {
    "objeto": "sabilaCorte",
    "giro": 0.12,
    "y": 1.7,
    "escala": 1.15,
    "etiqueta": "Gel = agua guardada 💧"
   }
  },
  {
   "id": "s6",
   "plantilla": "contador",
   "text": "Y ese gel es casi pura agua: alrededor del noventa y nueve por ciento.",
   "p": {
    "numero": "99%",
    "size": 1.6,
    "palabra": "AGUA"
   }
  },
  {
   "id": "s7",
   "plantilla": "persona",
   "text": "Y lo más raro: la sábila abre sus poros de noche, y los cierra durante el día.",
   "p": {
    "escenario": "oficina",
    "accion": "señalar",
    "persona": {
     "tono": 2,
     "peinado": "largo",
     "ropa": "#264653",
     "pelo": "#2b1a10"
    },
    "objeto": "sabila",
