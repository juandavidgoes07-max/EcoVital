     }
    ],
    "titulo": "¿Flota o se <b>hunde</b>?"
   }
  },
  {
   "id": "m2",
   "plantilla": "quiz",
   "text": "Adivina por qué flota. No es porque sea liviana: es porque por dentro tiene aire.",
   "p": {
    "pregunta": "¿Por qué <b>flota</b>?",
    "opciones": [
     "Porque es liviana",
     "Porque tiene aire",
     "Por la cáscara"
    ],
    "correcta": 1,
    "heroe": "manzana2",
    "escalaHeroe": 1.2,
    "giroHeroe": 0.5
   }
  },
  {
   "id": "m3",
   "plantilla": "dato",
   "text": "Entre sus células hay bolsitas de aire, como si fuera una esponja muy apretada.",
   "p": {
    "objeto": "manzanaCorte",
    "etiqueta": "Bolsitas de aire 🫧",
    "giro": 0.0,
    "y": 2.0,
    "escala": 1.45
   }
  },
  {
   "id": "m4",
   "plantilla": "contador",
   "text": "Más o menos la cuarta parte de una manzana es puro aire. Por eso flota.",
   "p": {
    "numero": "25%",
    "size": 1.5,
    "palabra": "AIRE"
   }
  },
  {
   "id": "m5",
   "plantilla": "versus",
   "text": "La papa, en cambio, es más densa que el agua, y por eso se va derechito al fondo.",
   "p": {
    "a": "manzana2",
    "b": "papa",
    "escalaHeroe": 0.95,
    "giroHeroe": 0.4,
    "yA": 1.5,
    "yB": 1.4,
    "etY": 1.3,
    "etA": "Tiene aire 🫧",
    "etB": "Más densa"
   }
  },
  {
   "id": "m6",
   "plantilla": "dato",
   "text": "Y otro dato que casi nadie sabe: la manzana pertenece a la familia de las rosas.",
