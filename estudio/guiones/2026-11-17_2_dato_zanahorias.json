  {
   "id": "t1",
   "plantilla": "gancho",
   "text": "Las zanahorias no siempre fueron naranjas. Las primeras eran moradas y amarillas.",
   "p": {
    "heroe": "zanahorias",
    "titulo": "Antes eran<br><b>MORADAS</b>"
   }
  },
  {
   "id": "t2",
   "plantilla": "quiz",
   "text": "A ver, adivina: ¿de qué color era la primera zanahoria que se cultivó?",
   "p": {
    "heroe": "zanahoria",
    "color": "#5b2a6e",
    "pregunta": "¿De qué <b>color</b> eran?",
