     "Morada 🟣",
     "Blanca ⚪"
    ],
    "correcta": 1
   }
  },
  {
   "id": "t3",
   "plantilla": "dato",
   "text": "Se cultivaron primero en Asia Central hace unos mil años, moradas o amarillas.",
   "p": {
    "objeto": "zanahorias",
    "colores": [
     "#5b2a6e",
     "#f2c14e"
    ],
    "etiqueta": "Asia Central",
