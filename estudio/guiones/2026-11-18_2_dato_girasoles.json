 "scenes": [
  {
   "id": "t1",
   "plantilla": "gancho",
   "text": "Todos creen que los girasoles siguen al sol. Es verdad, pero solo a medias.",
   "p": {
    "heroe": "girasol",
    "titulo": "¿Los girasoles<br><b>siguen al sol</b>?"
   }
  },
  {
   "id": "t2",
   "plantilla": "quiz",
   "text": "Adivina: un girasol adulto, ¿mira al sol todo el día, mira al oriente, o mira al piso?",
   "p": {
    "heroe": "girasol",
    "pregunta": "Un girasol <b>adulto</b>…",
    "opciones": [
     "Sigue al sol",
     "Mira al oriente",
     "Mira al piso"
    ],
    "correcta": 1
   }
  },
  {
   "id": "t3",
   "plantilla": "sigueSol",
   "text": "De jóvenes sí lo siguen: amanecen mirando al oriente y en la tarde miran al occidente.",
   "p": {
    "sticker": "GIRASOL JOVEN 🌱"
   }
  },
  {
   "id": "t4",
   "plantilla": "reloj",
   "text": "Y de noche se giran de vuelta, guiados por su propio reloj interno.",
   "p": {
    "etiqueta": "Reloj interno",
    "sticker": "DE NOCHE 🌙",
    "color": "#f2c14e"
   }
  },
  {
   "id": "t5",
   "plantilla": "persona",
   "text": "Pero cuando florecen, se quedan quietos, mirando siempre hacia el oriente.",
   "p": {
    "escenario": "calle",
    "accion": "sorpresa",
    "persona": {
     "tono": 2,
     "peinado": "moño",
     "ropa": "#2a9d8f",
     "pelo": "#2b1d16"
    },
    "sticker": "ADULTO = SE QUEDA QUIETO",
    "stickerY": 1400
   }
  },
  {
   "id": "t6",
   "plantilla": "sigueSol",
   "text": "¿Y por qué al oriente? Porque el sol de la mañana los calienta más rápido.",
   "p": {
    "adulto": true,
    "sticker": "FLOR TIBIA ☀️"
   }
  },
  {
   "id": "t7",
   "plantilla": "dato",
   "text": "Y una flor tibia atrae a las abejas: reciben hasta cinco veces más visitas.",
   "p": {
    "objeto": "abeja",
    "etiqueta": "Abejas",
    "chips": [
     "hasta <b>5 veces</b> más visitas 🐝"
    ],
    "y": 2.0,
    "giro": 0.35,
    "escala": 1.6
   }
  },
  {
   "id": "t8",
   "plantilla": "comentario",
   "text": "¿Tú lo sabías? La próxima vez que veas un girasol, busca por dónde sale el sol.",
   "p": {
    "heroe": "girasol",
    "palabra": "NO SABÍA",
    "encima": "¿Tú <b>lo sabías</b>?",
    "escalaHeroe": 0.62
   }
  }
