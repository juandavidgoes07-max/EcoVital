 "scenes": [
  {
   "id": "e1",
   "plantilla": "gancho",
   "text": "La vainilla de tus postres viene de una orquídea, y su flor abre un solo día.",
   "p": {
    "heroe": "orquidea",
    "giroHeroe": 0,
    "titulo": "¿<b>Vainilla</b> = flor? 🌼",
    "sub": "y abre un solo día",
    "escalaHeroe": 1.5
   }
  },
  {
   "id": "e2",
   "plantilla": "quiz",
   "text": "Adivina: ¿qué parte de la planta es la vainilla? ¿Raíz, flor o fruto?",
   "p": {
    "pregunta": "¿La <b>vainilla</b> es…?",
    "opciones": [
     "Una raíz 🌱",
     "Una flor 🌼",
     "Un fruto 🫛"
    ],
    "correcta": 2,
    "heroe": "florVainilla",
    "giroHeroe": 0
   }
  },
  {
   "id": "e3",
   "plantilla": "dato",
   "text": "Es el fruto: una vaina verde y larga que tarda unos nueve meses en madurar.",
   "p": {
    "objeto": "vainaVerde",
    "etiqueta": "Vaina = fruto",
    "chips": [
     "⏳ ~9 meses"
    ],
    "giro": 0.3
   }
  },
  {
   "id": "e4",
   "plantilla": "reloj",
   "text": "Pero antes hay que polinizar la flor, y cada flor se abre solo un día.",
   "p": {
    "etiqueta": "Flor abierta",
    "sticker": "SOLO 1 DÍA ⏳"
   }
  },
  {
   "id": "e5",
   "plantilla": "persona",
   "text": "Lejos de México, su tierra, casi nadie la poliniza. Por eso se hace a mano, flor por flor.",
   "p": {
    "escenario": "invernadero",
    "accion": "señalar",
    "persona": {
     "tono": 0,
     "peinado": "moño",
     "ropa": "#3d5a80",
     "pelo": "#c9a36a"
    },
    "objeto": "orquidea",
    "objetoPos": [
     1.9,
     2.4,
     -0.4
    ],
    "objetoEscala": 0.9,
    "sticker": "A MANO 🖐️",
    "stickerY": 1380
   }
  },
  {
   "id": "e6",
   "plantilla": "contador",
   "text": "Ese truco se descubrió en mil ochocientos cuarenta y uno, en la isla Reunión, con una astilla fina.",
   "p": {
    "desde": 1800,
    "hasta": 1841,
    "etiqueta": "Isla Reunión 🏝️",
    "size": 1.05
   }
  },
  {
   "id": "e7",
   "plantilla": "versus",
   "text": "Después se cura por meses, y la vaina verde se vuelve negra y aromática.",
   "p": {
    "a": "vainaVerde",
    "b": "vainaNegra",
    "etA": "Cosechada",
    "etB": "Curada",
    "yA": 1.7,
    "yB": 1.7,
    "etY": 1.6,
    "giroHeroe": 0.4,
    "colorB": "#c98b4f"
   }
  },
  {
   "id": "e8",
   "plantilla": "dato",
   "text": "Por eso es una de las especias más caras del mundo, junto con el azafrán.",
   "p": {
