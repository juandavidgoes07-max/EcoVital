      "¿¿QUÉ?? 😳"
     ],
     [
      "e",
      "no preguntes 🙈"
     ]
    ]
   }
  },
  {
   "id": "a2",
   "plantilla": "lupa",
   "text": "Y es verdad: lo tapa con sales de aluminio. Míralo en la etiqueta, dice aluminum.",
