  {
   "id": "c1",
   "plantilla": "gancho",
   "text": "El café que tomas cada mañana en realidad es la semilla de una fruta.",
   "p": {
    "heroe": "taza",
    "escalaHeroe": 1.15,
    "giroHeroe": 0,
    "titulo": "Es una <b>semilla</b> ☕",
    "sub": "de una fruta 🍒"
   }
  },
  {
   "id": "c2",
   "plantilla": "quiz",
   "text": "Adivina de qué color es esa fruta cuando está madura.",
   "p": {
    "pregunta": "¿De qué <b>color</b> es?",
    "opciones": [
     "Verde",
     "Roja",
     "Café"
    ],
    "correcta": 1,
    "heroe": "cerezaCafe",
    "giroHeroe": 0.5,
    "escalaHeroe": 0.55
   }
  },
  {
   "id": "c3",
   "plantilla": "dato",
   "text": "Roja. Se llama cereza de café y crece en racimos pegados a la rama.",
   "p": {
    "objeto": "cafeto",
    "y": 2.0,
    "escala": 0.88,
    "giro": 0.15,
    "etiqueta": "Cereza de café 🍒"
   }
  },
  {
   "id": "c4",
   "plantilla": "dato",
   "text": "Por dentro casi siempre trae dos semillas, pegadas por su lado plano.",
   "p": {
    "objeto": "cerezaAbierta",
    "y": 1.9,
    "escala": 0.78,
    "giro": 0.12,
    "grande": "SON 2"
   }
  },
  {
   "id": "c5",
   "plantilla": "contador",
   "text": "Pero en más o menos cinco de cada cien cerezas sale una sola, redondita.",
   "p": {
    "numero": "5%",
    "size": 1.9,
    "palabra": "¡SOLO 1!"
   }
  },
  {
   "id": "c6",
   "plantilla": "sello",
   "text": "En Colombia, a ese grano redondo le dicen caracol.",
   "p": {
    "heroe": "caracolCafe",
    "giroHeroe": 0.7,
    "texto": "CARACOL",
    "tipo": "realidad",
    "frase": "Así le dicen en Colombia 🇨🇴",
    "escalaHeroe": 0.85
   }
  },
  {
   "id": "c7",
   "plantilla": "versus",
   "text": "Y cruda, la semilla es verde clarita. Se vuelve café cuando la tuestan.",
   "p": {
    "a": "granoCafe",
    "b": "granoTostado",
